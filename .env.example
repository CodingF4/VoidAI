# Copy this file to .env and fill in your own values. Never commit .env.

# Required: Google AI Studio key (free tier is enough for a portfolio demo)
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash
# GEMINI_MODEL=gemini-2.5-flash

# Required: used to sign login sessions. Use a long random string.
SESSION_SECRET=

# Required: a private code needed to register an admin account
ADMIN_CODE=

# Server port. Vercel sets PORT automatically.
PORT=5000

# Optional. Only needed if you want paid subscription checkout to work.
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_ELITE=

# Optional. The app currently stores users and messages in memory.
# A Neon Postgres URL is ready to use once storage is wired to Drizzle.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
